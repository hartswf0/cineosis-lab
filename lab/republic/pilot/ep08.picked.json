     "fit": 0.251
    }
   ]
  },
  {
   "k": "talk",
   "who": "BRO-CRATES",
   "text": "Congratulations, Don. You just liberated your own brisket.",
   "wav": "pilot/ep08/v28.wav",
   "d": 3.75,
   "e": "003zzzpwzvuvkzysbwvtvxxyvsuvxswrid000000"
  },
  {
   "k": "talk",
   "who": "BIG DON",
   "text": "...So the cow is... emancipated.",
   "wav": "pilot/ep08/v29.wav",
   "d": 3.125,
   "e": "0000hzztozzxzzwpc9pvutcm7rrkl90000000000"
  },
  {
