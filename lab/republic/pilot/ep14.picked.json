     "y": 1973,
     "q": "a small aircraft hovering in the sky",
     "fit": 0.294
    },
    {
     "v": "https://pub-075ff01374c04555b51c9bc50f258b42.r2.dev/sources/621e7ffc-95b3-57ac-8ca2-1dec6af30a6c/v3-ffmpeg-openclip-1/clips/46d0b28f-ed15-5bf4-9747-39d6c5af7093.mp4",
     "in": 11.0,
     "dur": 19.29,
     "src": "Reasons Why, The (Part I)",
     "y": 1959,
     "q": "a loudspeaker on a pole",
     "fit": 0.337
    }
   ]
  },
  {
   "k": "talk",
   "who": "T-REX",
   "text": "The drone is lying.",
   "wav": "pilot/ep14/v26.wav",
   "d": 2.261,
   "e": "000008trhkrzzzxwtoiif5hkrrojf71000000000"
  },
  {
   "k": "talk",
   "who": "STRYDER",
   "text": "Yeah. That’s kind of the point.",
   "wav": "pilot/ep14/v27.wav",
   "d": 2.075,
   "e": "0000hzywqtzzrhnesyxwlt77uuoj8b1000000000"
  },
  {
   "k": "talk",
   "who": "T-REX",
   "text": "Then I will also lie.",
   "wav": "pilot/ep14/v28.wav",
   "d": 2.511,
   "e": "00008ozxxyzvwwqzyjfdpmgoqomhd00000000000"
  },
  {
   "k": "talk",
   "who": "STRYDER",
   "text": "…How?",
   "wav": "pilot/ep14/v29.wav",
   "d": 1.05,
   "e": "000000004fkovzzzzywuwrrj3000000000000000"
  },
  {
   "k": "talk",
   "who": "T-REX",
   "text": "I will tell the State I did not eat your jeep.",
   "wav": "pilot/ep14/v30.wav",
   "d": 3.936,
   "e": "000uzxmzuwjqzudsouvwp8pblg8pl70000000000"
  },
  {
   "k": "chorus",
   "ask": "you can't believe everything they tell you",
   "who": "A CITIZEN",
   "v": "https://pub-075ff01374c04555b51c9bc50f258b42.r2.dev/sources/17aedca9-3b2b-5f9d-b5b6-0a071bb5a51f/v4-conditional-luna-1/clips/b355f2e1-c403-5845-b4ed-202874718136.mp4",
   "in": 3.06,
   "d": 3.97,
   "said": "Sometimes they show us more than they know.",
   "src": "Energy - The American Experience",
   "y": 1994
  },
  {
   "k": "talk",
   "who": "RUBY",
   "text": "LADIES AND GENTLEMEN, THE FIRST DINOSAUR TO DISCOVER PLAUSIBLE DENIABILITY!",
