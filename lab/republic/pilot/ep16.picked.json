  {
   "k": "talk",
   "who": "THE PODCASTER",
   "text": "So it does understand art.",
   "wav": "pilot/ep16/v31.wav",
   "d": 2.525,
   "e": "0000hzzw9zzvlivurjl4sqppmctth30000000000"
  },
