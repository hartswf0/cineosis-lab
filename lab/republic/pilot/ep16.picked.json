   ]
  },
  {
   "k": "talk",
   "who": "THE SHEPHERD",
   "text": "Are we watching truth, or watching ourselves watching truth?",
   "wav": "pilot/ep16/v28.wav",
   "d": 4.65,
   "e": "05zvynxourflzw40000zyxxvwvrzulvxssjxu500"
  },
  {
   "k": "talk",
   "who": "THE REGENT",
   "text": "Don’t get poetic. Poetry triggers the storm.",
   "wav": "pilot/ep16/v29.wav",
   "d": 3.525,
   "e": "000wyrwdtzypsb0jzykusnyutjqmnzxpke000000"
  },
  {
   "k": "narr",
   "text": "A bar crashes through the ceiling and lands upright, like a tombstone. On it, in white letters: metaphor detected.",
