  },
  {
   "k": "narr",
   "text": "Then, with no footsteps at all, a third man is simply there. The Regent, an official in a dark suit, carrying scissors that are also a pen.",
   "see": [
    "a man in a dark suit standing in the desert",
    "a pair of scissors cutting paper"
   ],
   "mood": "tension and suspense",
   "wav": "pilot/ep16/v06.wav",
