   "who": "DAISY",
   "text": "No.",
   "wav": "pilot/ep13/v26.wav",
   "d": 1.175,
   "e": "0000000aryyyzzzyxvusoh000000000000000000"
  },
  {
   "k": "talk",
   "who": "STRYDER",
   "text": "Does it belong to me?",
   "wav": "pilot/ep13/v27.wav",
   "d": 1.7,
   "e": "00000nvlxgiyvzzzvshltuurng94000000000000"
  },
  {
   "k": "talk",
   "who": "DAISY",
   "text": "No.",
   "wav": "pilot/ep13/v28.wav",
   "d": 1.175,
   "e": "0000000aryyyzzzyxwusoi000000000000000000"
  },
  {
   "k": "talk",
   "who": "STRYDER",
   "text": "Then to whom does it belong?",
