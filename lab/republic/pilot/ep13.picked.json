     "v": "https://pub-075ff01374c04555b51c9bc50f258b42.r2.dev/sources/5241e605-a8ae-5cec-8807-e0e73dd91a56/v4-conditional-luna-1/clips/f1a48695-536c-5131-bb32-cea93daa00e8.mp4",
     "in": 2.0,
     "dur": 4.37,
     "src": "Pre-Operation Inspection of Off-Road Haulage Trucks by the Driver",
     "y": 2004,
     "q": "a man measuring a truck tire",
     "fit": 0.382
    }
   ]
  },
  {
   "k": "talk",
   "who": "DAISY",
   "text": "If you insist on measuring, let us measure correctly.",
   "wav": "pilot/ep13/v16.wav",
   "d": 3.7,
   "e": "00vpzzzjymxwwxrusl0wypuxrsavs0okc0000000"
  },
  {
   "k": "talk",
   "who": "STRYDER",
   "text": "Define \"correctly.\"",
   "wav": "pilot/ep13/v17.wav",
   "d": 1.775,
   "e": "00000spcyzyyxqipyzzt03lsplga000000000000"
  },
  {
   "k": "talk",
   "who": "DAISY",
   "text": "According to the Form of the Good.",
   "wav": "pilot/ep13/v18.wav",
   "d": 2.275,
   "e": "000dfcyzzzyprtl5yyvvitaxvqog600000000000"
  },
  {
   "k": "talk",
   "who": "STRYDER",
   "text": "Is \"ready for anything\" courage… or merely paranoia?",
   "wav": "pilot/ep13/v19.wav",
   "d": 3.5,
   "e": "00tvnzvrwtyjxvjwyrml0myzzwmovsutjb000000"
  },
  {
   "k": "talk",
   "who": "DAISY",
   "text": "Is paranoia irrational… or simply prudence with a hat?",
   "wav": "pilot/ep13/v20.wav",
   "d": 4.05,
   "e": "00tdjxzzzuvuwpnrn00vjvtrpxvioppo90000000"
  },
  {
   "k": "talk",
   "who": "STRYDER",
   "text": "Is prudence a virtue…",
   "wav": "pilot/ep13/v21.wav",
   "d": 1.95,
   "e": "0000gxl70jyzuzwmrukzzt4optnia20000000000"
  },
  {
   "k": "talk",
   "who": "DAISY",
   "text": "—or a justification?",
   "wav": "pilot/ep13/v22.wav",
   "d": 2.075,
   "e": "0000lxzzvkzxe5pgr4buurd9pnli600000000000"
  },
  {
   "k": "chorus",
   "ask": "those two were made for each other",
   "who": "A CITIZEN",
   "v": "https://pub-075ff01374c04555b51c9bc50f258b42.r2.dev/sources/how-do-you-know-it-s-love/clips/0000347480-0000368501.mp4",
   "in": 4.78,
   "d": 2.37,
   "said": "I guess that was a stage of love.",
   "src": "How Do You Know It's Love?",
   "y": 1950
  },
  {
   "k": "narr",
