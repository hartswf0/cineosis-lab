     "y": 1936,
     "q": "a woman picking up car keys",
     "fit": 0.336
    },
    {
     "v": "https://pub-075ff01374c04555b51c9bc50f258b42.r2.dev/sources/7f791137-0a84-559e-8495-4714858bf07f/v4-conditional-luna-1/clips/211e6206-f071-57a4-82a9-30e7d00499b0.mp4",
     "in": 3.0,
     "src": "Place to Live, A",
     "y": 1948,
     "q": "p2a"
    }
   ]
  },
  {
   "k": "talk",
   "who": "CHAD",
   "text": "Wait, babe, if you leave, what am I supposed to tell the Board?",
   "wav": "pilot/ep07/v28.wav",
   "d": 3.925,
   "e": "000zsszxtvpxzxq900ozutuvxnmxtuyuk0000000"
  },
  {
   "k": "talk",
   "who": "BECKY",
   "text": "Tell them your \"traditional values\" got outvoted by consent.",
   "wav": "pilot/ep07/v29.wav",
   "d": 3.925,
   "e": "000nzzzwpwvxvwxsnmm00rxtsxzytrpusof80000"
  },
  {
   "k": "narr",
   "text": "The door closes. Chad stands alone in the kitchen, holding a form he suddenly hates.",
