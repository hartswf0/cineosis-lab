     "fit": 0.338
    }
   ]
  },
  {
   "k": "intro",
   "who": "CHAD"
  },
  {
   "k": "talk",
   "who": "CHAD",
   "text": "Babe! Okay. So. Great news.",
   "wav": "pilot/ep07/v03.wav",
   "d": 2.45,
   "e": "0000nzxiztdywpmnzvodvzqdvvrjfl0000000000"
  },
  {
   "k": "intro",
   "who": "BECKY"
  },
  {
   "k": "talk",
   "who": "BECKY",
   "text": "No.",
   "wav": "pilot/ep07/v05.wav",
   "d": 1.3,
   "e": "000000000000wzzzyxwtrrqk0000000000000000"
  },
  {
   "k": "talk",
   "who": "CHAD",
   "text": "Okay, so, you know how the Board of Regents is modernizing marriage?",
   "wav": "pilot/ep07/v06.wav",
   "d": 4.425,
   "e": "00wnztyx20nzvxuszysvuoqrywwvqtwujg500000"
  },
  {
   "k": "talk",
   "who": "BECKY",
   "text": "Marriage does not need an update. Marriage is not an app.",
   "wav": "pilot/ep07/v07.wav",
   "d": 3.75,
   "e": "000xzztpwwxuwuuu6ok6000yzzwrtxvurj000000"
  },
  {
   "k": "narr",
   "text": "Chad lays an official form on the counter. The Board wants marriage run as a state program, and Chad has volunteered his. His wife reads it without blinking.",
   "see": [
    "a government form on a table",
    "a woman reading a document in a kitchen"
   ],
   "mood": "tension and suspense",
   "wav": "pilot/ep07/v08.wav",
   "d": 11.025,
   "e": "0zwzvvyvxo0vzxwwxtvuxsmzuxxxuk0zuztwxl00",
   "shots": [
    {
     "v": "https://pub-075ff01374c04555b51c9bc50f258b42.r2.dev/sources/e8ef7ef6-43ae-5eaa-9f80-8d2a94ab2deb/v4-conditional-luna-1/clips/d0a22c77-a70e-5d32-b74f-d03119f30e07.mp4",
     "in": 7.0,
     "dur": 17.25,
     "src": "Project Thunderstorm, 05/1947 - 09/1947",
     "y": 1947,
     "q": "a government form on a table",
     "fit": 0.337
    },
    {
     "v": "https://pub-075ff01374c04555b51c9bc50f258b42.r2.dev/sources/all-my-babies/clips/0002780330-0002803000.mp4",
     "in": 0.0,
     "dur": 22.67,
     "src": "All My Babies",
     "y": 1953,
     "q": "a woman reading a document in a kitchen",
     "fit": 0.288
    }
   ]
  },
  {
   "k": "intro",
   "who": "HUEY"
  },
  {
   "k": "talk",
   "who": "HUEY",
   "text": "He is about to \"tradition\" his way into a divorce.",
   "wav": "pilot/ep07/v10.wav",
   "d": 3.975,
   "e": "000zzztzlncnsyric00sozyrnqqqpksnaf000000"
  },
  {
   "k": "talk",
   "who": "CHAD",
   "text": "Plato says the family unit makes people selfish, right? So, we're doing family values... statewide.",
   "wav": "pilot/ep07/v11.wav",
   "d": 6.4,
   "e": "04zwyuwxzvusrpxoru00wzyztvvxsja0suse0000"
  },
  {
   "k": "talk",
   "who": "BECKY",
   "text": "That is not family values. That is you trying to outsource commitment like it's lawn care.",
   "wav": "pilot/ep07/v12.wav",
   "d": 5.55,
   "e": "00wyyz5xxvvoin000zysyvttvqxqsrpqxznn7000"
  },
  {
   "k": "talk",
   "who": "CHAD",
   "text": "Okay, look. The state is simply recognizing your function.",
   "wav": "pilot/ep07/v13.wav",
   "d": 3.975,
   "e": "000zjzxvzc000spzuqxpwzmqwttw8wqmn7000000"
  },
  {
   "k": "talk",
   "who": "BECKY",
   "text": "My what.",
   "wav": "pilot/ep07/v14.wav",
   "d": 1.425,
   "e": "00000000000wzzzzyrwwuqndjsh0000000000000"
  },
  {
   "k": "talk",
   "who": "CHAD",
   "text": "Your function. Like, the soul has parts. And each part does its job. It's justice.",
   "wav": "pilot/ep07/v15.wav",
   "d": 5.0,
   "e": "00yvxvyzwqzxxoyk70dxykyvwiywtthzkoh00000"
  },
  {
   "k": "chorus",
   "ask": "a marriage is between two people",
   "who": "A CITIZEN",
   "v": "https://pub-075ff01374c04555b51c9bc50f258b42.r2.dev/sources/a46a460b-3045-5111-bc0e-2339c80c4da0/v4-conditional-luna-1/clips/bc6c7b15-cd99-5957-bd28-0f38b8e97a4e.mp4",
   "in": 1.94,
   "d": 3.17,
   "said": "Expect to live on that marriage.",
   "src": "Wreckless",
   "y": 1935
  },
  {
   "k": "narr",
   "text": "Becky reaches into her bag and slides a form of her own across the counter. It is already stamped and filed: a petition for divorce.",
   "see": [
    "a woman sliding a paper across a table",
    "a rubber stamp on a document"
   ],
   "mood": "tension and suspense",
   "wav": "pilot/ep07/v17.wav",
   "d": 9.525,
   "e": "0vzwyzxqvvwtywypvxvi0zzypwnwxn0szxvxtl00",
   "shots": [
    {
     "v": "https://pub-075ff01374c04555b51c9bc50f258b42.r2.dev/sources/e48a8ddf-d447-5ec1-92c6-e59f5b44e654/v4-conditional-luna-1/clips/7940758e-b7cc-5ee1-b6dd-d6659e7ba376.mp4",
     "in": 0.0,
     "dur": 18.18,
     "src": "Reasons Why, The (Part II)",
     "y": 1959,
     "q": "a woman sliding a paper across a table",
     "fit": 0.264
    },
    {
     "v": "https://pub-075ff01374c04555b51c9bc50f258b42.r2.dev/sources/39ad9220-677a-577e-be9b-bd628a9c12af/v5-windowed-clip-split-1/clips/bbd41e0a-92ef-58eb-b165-8ea7434b23af.mp4",
     "in": 0.0,
     "dur": 54.07,
     "src": "TROUBLESHOOTING ELECTRIC CIRCUITS",
     "y": 1968,
     "q": "a rubber stamp on a document",
     "fit": 0.263
    }
   ]
  },
  {
   "k": "talk",
   "who": "CHAD",
   "text": "What is that.",
   "wav": "pilot/ep07/v18.wav",
   "d": 1.5,
   "e": "0000000mxzzqyxrpjvzwvqoj0b10000000000000"
  },
  {
   "k": "talk",
   "who": "BECKY",
   "text": "That's my signature.",
   "wav": "pilot/ep07/v19.wav",
   "d": 1.925,
   "e": "0000000kzzy4pozywpnmznxufnmmie0000000000"
  },
  {
   "k": "talk",
   "who": "CHAD",
   "text": "But... we're not allowed to have private families.",
   "wav": "pilot/ep07/v20.wav",
   "d": 3.075,
   "e": "000ezs0szxvswzxuusx47wwxdvwvsnis60000000"
  },
  {
   "k": "talk",
   "who": "BECKY",
   "text": "Exactly.",
   "wav": "pilot/ep07/v21.wav",
   "d": 1.625,
   "e": "0000000000zyvvswzzt7ckromng0000000000000"
  },
  {
   "k": "talk",
   "who": "CHAD",
   "text": "So... how can you...",
   "wav": "pilot/ep07/v22.wav",
   "d": 1.825,
   "e": "00000epzzyroqzw6hzwvuwwupod0000000000000"
  },
  {
   "k": "talk",
   "who": "BECKY",
   "text": "I'm not having a private family. I'm having a private exit.",
   "wav": "pilot/ep07/v23.wav",
   "d": 4.05,
   "e": "000yzzovwynturoupkj000syxxzsuvuwtsfn0000"
  },
  {
   "k": "chorus",
   "ask": "I think she did the right thing",
   "who": "A CITIZEN",
   "v": "https://pub-075ff01374c04555b51c9bc50f258b42.r2.dev/sources/don-t-be-afraid/clips/0000319953-0000340473.mp4",
   "in": 6.33,
   "d": 2.64,
   "said": "She didn't have to be afraid of the dog.",
   "src": "Don't Be Afraid",
   "y": 1953
  },
  {
   "k": "talk",
   "who": "CHAD",
   "text": "Huey. Tell her this is justice.",
   "wav": "pilot/ep07/v25.wav",
   "d": 2.45,
   "e": "00000uzyyuo1szwyrwitpeizqicofg4000000000"
  },
  {
   "k": "talk",
   "who": "HUEY",
   "text": "Justice is each part doing its proper function. Her proper function appears to be leaving you.",
   "wav": "pilot/ep07/v26.wav",
   "d": 6.175,
   "e": "0gzzwsvkxnywjzsnwlc0htzxlyopkwltwtpa0000"
  },
  {
   "k": "narr",
   "text": "Becky picks up her car keys. Her sister lives across town, in the Bronze class.",
   "see": [
    "a woman picking up car keys",
    {
     "place": "p2a"
    }
   ],
   "mood": "a journey in motion",
