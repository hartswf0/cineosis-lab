     "src": "Fate of the forests, ca. 1980 - ca. 1985",
     "y": null,
     "q": "a truck parked at the edge of a ravine",
     "fit": 0.351
    }
   ]
  },
  {
   "k": "talk",
   "who": "MATEO",
   "text": "This is a set-up.",
   "wav": "pilot/ep06/v21.wav",
   "d": 1.85,
   "e": "00002vzzvklqyxtyvmiiuzxvxtsk0gja00000000"
  },
  {
   "k": "talk",
   "who": "WALTER",
   "text": "No. This is education.",
   "wav": "pilot/ep06/v22.wav",
   "d": 2.5,
   "e": "0000wzzyvowwldwvluypwjnzxroopljf30000000"
  },
  {
   "k": "narr",
