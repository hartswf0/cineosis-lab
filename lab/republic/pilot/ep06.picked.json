  },
  {
   "k": "intro",
   "who": "MATEO"
  },
  {
   "k": "talk",
   "who": "MATEO",
   "text": "You put a statue in a cow field like it's a church.",
   "wav": "pilot/ep06/v03.wav",
   "d": 3.325,
   "e": "000zszwlzvmxwwrgxyt7yvswxsptlxq6j8000000"
  },
  {
   "k": "intro",
   "who": "WALTER"
  },
  {
   "k": "talk",
   "who": "WALTER",
   "text": "It is a church.",
   "wav": "pilot/ep06/v05.wav",
   "d": 1.95,
   "e": "00000szsotzstwo5hoozxxvrj9hhjhd200000000"
  },
  {
   "k": "talk",
   "who": "MATEO",
   "text": "You took land I pay for. You're running product through my routes. And you're telling my people you're a state.",
   "wav": "pilot/ep06/v06.wav",
   "d": 5.825,
   "e": "0qyyzztyrqkzzwtywszxyrp00wyxwyuuvtuk9000"
  },
  {
   "k": "talk",
   "who": "WALTER",
   "text": "Not a state. A polis.",
   "wav": "pilot/ep06/v07.wav",
   "d": 2.325,
   "e": "0000rzzsxpj8yxxtfg3tpjzyxsmjfdd800000000"
  },
  {
   "k": "narr",
   "text": "Behind Walter, in the shade of a windmill, three hundred men stand perfectly still with spears and rifles. He calls them his guardians.",
   "see": [
    "men standing in rows beside a windmill",
    {
     "place": "p1a"
    }
   ],
   "mood": "tension and suspense",
   "wav": "pilot/ep06/v08.wav",
   "d": 9.525,
   "e": "0zyuw0zxxwppzxxuwtwvuvstxuzql0nzwzvxqj00",
   "shots": [
    {
     "v": "https://pub-075ff01374c04555b51c9bc50f258b42.r2.dev/sources/f6095d95-8114-539e-ba13-8bf3ade62671/v4-conditional-luna-1/clips/8ef7038e-7eb8-5aab-a31f-686ea476eea4.mp4",
     "in": 8.0,
     "dur": 9.71,
     "src": "[Amateur films: Ivan Besse collection: Britton, South Dakota 1938-39] ",
     "y": 1938,
     "q": "men standing in rows beside a windmill",
     "fit": 0.332
    },
