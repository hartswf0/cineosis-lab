  {
   "k": "talk",
   "who": "MATEO",
   "text": "You think this makes you righteous?",
   "wav": "pilot/ep06/v25.wav",
   "d": 2.375,
   "e": "0000xzuwztkxwkxyslmxxtzzviopkkic00000000"
  },
  {
   "k": "talk",
   "who": "WALTER",
   "text": "No. It makes me inevitable.",
   "wav": "pilot/ep06/v26.wav",
   "d": 2.55,
   "e": "0000vzzywsrhzwjovymsxwzsumtknkg800000000"
  },
  {
   "k": "talk",
   "who": "MATEO",
   "text": "This isn't over.",
   "wav": "pilot/ep06/v27.wav",
   "d": 1.875,
   "e": "00003uzxrjguzuuxxoipzxwtjtrpmjb000000000"
  },
  {
   "k": "talk",
   "who": "WALTER",
   "text": "Nothing ever is.",
   "wav": "pilot/ep06/v28.wav",
   "d": 2.1,
   "e": "0000fvzzrawwvn0ozwvwnrwwtnli9a9000000000"
  },
  {
