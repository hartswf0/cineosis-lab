   "ask": "nobody wants to hear the truth if it hurts",
   "who": "A CITIZEN",
   "v": "https://pub-075ff01374c04555b51c9bc50f258b42.r2.dev/sources/all-my-babies/clips/0003160380-0003181580.mp4",
   "in": 9.6,
   "d": 2.27,
   "said": "And that the wounds is all right.",
   "src": "All My Babies",
   "y": 1953
  },
  {
   "k": "narr",
   "text": "Something new has appeared in the system, something it cannot classify. Now the machine orders the Ranger to neutralize Kano.",
