  },
  {
   "k": "talk",
   "who": "SOCRATES-117",
   "text": "Why are you here?",
   "wav": "pilot/ep12/v10.wav",
   "d": 1.625,
   "e": "0000001jtxzzzwyyvpnrsof60jliie8000000000"
  },
  {
   "k": "narr",
   "text": "From his coat Kano takes a paper tray holding two cubes of brisket. One glows faintly red. The other glows faintly blue.",
