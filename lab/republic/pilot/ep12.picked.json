   "shots": [
    {
     "v": "https://pub-075ff01374c04555b51c9bc50f258b42.r2.dev/sources/81918544-d7c3-52b9-bd85-b6d3c68e3cb2/v4-conditional-luna-1/clips/1a9416f3-ecaa-59cb-a07b-f4deb7118dde.mp4",
