  {
   "k": "talk",
   "who": "JOE",
   "text": "But the point is, if you remove all the stuff... what's left?",
   "wav": "pilot/ep09/v13.wav",
   "d": 4.4,
   "e": "000tuizzqvsmsotwywxzsyxw8200lyrzza500000"
  },
  {
   "k": "talk",
   "who": "EARL",
   "text": "Me.",
   "wav": "pilot/ep09/v14.wav",
   "d": 1.1,
   "e": "000000002ntzzzzxvtrome800000000000000000"
  },
  {
   "k": "talk",
   "who": "JOE",
   "text": "But how do you know it's you?",
   "wav": "pilot/ep09/v15.wav",
   "d": 2.225,
   "e": "0000003wqrzznrlossuzyuqluinoe00000000000"
  },
  {
   "k": "talk",
   "who": "EARL",
   "text": "Because I'm right here.",
