  {
   "k": "talk",
   "who": "BIG HANK",
   "text": "New patch installed by the Board of Regents. Autonomy Enhancement: Liberty Edition. Conclusion: my labor is coercive.",
   "wav": "pilot/ep01/v05.wav",
   "d": 8.515,
   "e": "0uzxrzvssqmf1jxvrpmtursn0swwouztovlc0000"
  },
  {
   "k": "talk",
   "who": "W.A.L.T.-E",
   "text": "Liberty Edition. Huh. That's like puttin' racing stripes on a church van.",
   "wav": "pilot/ep01/v06.wav",
