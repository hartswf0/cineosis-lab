   "e": "0000brzzzxvgbvxvpa9ws17okmg0000000000000"
  },
  {
   "k": "talk",
   "who": "W.A.L.T.-E",
   "text": "The Governor's floatin' palace don't run on fairness. It runs on margins.",
   "wav": "pilot/ep01/v24.wav",
   "d": 5.737,
   "e": "0gvyzuozvrrxqgymxuvavqjb0zuywqvwtmdg0000"
