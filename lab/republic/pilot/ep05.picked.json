  {
   "k": "narr",
   "text": "The Governor speaks through a gramophone horn: Tex may leave if he thinks correctly. His handcuffs ask the questions. A masked guard holds a gun that fires only on valid arguments.",
   "see": [
    "a gramophone horn",
    "handcuffs on a man's wrists"
   ],
   "mood": "tension and suspense",
   "wav": "pilot/ep05/v02.wav",
